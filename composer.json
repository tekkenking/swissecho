{
    "name": "tekkenking/swissecho",
    "description": "One fluent Laravel API for SMS, voice, WhatsApp, Slack and Telegram. Switch gateways per request, route by recipient country, and mock sends in development.",
    "keywords": ["laravel", "php", "sms", "voice", "whatsapp", "slack", "telegram", "notifications", "notification-channel", "otp", "multi-gateway"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Tekkenking\\Swissecho\\": "src/"
        },
        "files": [
            "src/SwissechoHelpers.php"
        ]
    },
    "authors": [
        {
            "name": "Temitayo",
            "email": "bucketcodes@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "giggsey/libphonenumber-for-php-lite": "^8.13|^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50|^12.5.22",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tekkenking\\Swissecho\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tekkenking\\Swissecho\\SwissechoServiceProvider"
            ],
            "aliases": {
                "Swissecho": "Tekkenking\\Swissecho\\Facades\\Swissecho"
            }
        }
    }
}
